{% liquid
  assign hero_alignment = section.settings.text_alignment | default: 'left'
  assign hero_position = section.settings.content_position | default: 'center'
%}

<section class="section-shell hero-editorial hero-editorial--align-{{ hero_alignment }} hero-editorial--{{ hero_position }}">
  <div class="page-width hero-editorial__grid">
    <div class="hero-editorial__content">
      {% if section.settings.vertical_text != blank %}
        <div class="hero-editorial__vertical">{{ section.settings.vertical_text }}</div>
      {% endif %}

      {% if section.settings.eyebrow != blank %}
        <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}

      <h1 class="section-heading">{{ section.settings.heading }}</h1>

      {% if section.settings.copy != blank %}
        <div class="hero-editorial__description">{{ section.settings.copy }}</div>
      {% endif %}

      {% if section.settings.founder_detail != blank %}
        <div class="hero-editorial__detail">{{ section.settings.founder_detail }}</div>
      {% endif %}

      <div class="hero-editorial__actions">
        {% if section.settings.primary_label != blank %}
          <a class="button" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">
            {{ section.settings.primary_label }}
          </a>
        {% endif %}
        {% if section.settings.secondary_label != blank %}
          <a class="button button--secondary" href="{{ section.settings.secondary_link | default: routes.root_url }}">
            {{ section.settings.secondary_label }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="hero-editorial__media">
      {% if section.settings.mobile_image != blank %}
        <div class="hero-editorial__media-mobile">
          {{
            section.settings.mobile_image
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              widths: '480,720,960,1200',
              sizes: '100vw',
              alt: section.settings.heading
          }}
        </div>
      {% endif %}

      <div class="hero-editorial__media-desktop{% if section.settings.mobile_image == blank %} is-shared{% endif %}">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1800
            | image_tag:
              loading: 'eager',
              widths: '720,900,1200,1500,1800',
              sizes: '(min-width: 1100px) 60vw, 100vw',
              alt: section.settings.heading
          }}
        {% else %}
          <img
            src="{{ 'micnic-photo-home-hero.png' | asset_url }}"
            alt="{{ section.settings.heading | escape }}"
            loading="eager"
          >
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "premium men's lifestylewear"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Modern essentials. Timeless principles."
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Copy",
      "default": "<p>Premium men’s lifestylewear that moves effortlessly from performance to everyday.</p>"
    },
    {
      "type": "text",
      "id": "vertical_text",
      "label": "Vertical detail",
      "default": "live timeless"
    },
    {
      "type": "text",
      "id": "founder_detail",
      "label": "Founder or year detail",
      "default": "Sydney / est. 2026"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "shop now"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "our story"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "Bottom" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Editorial hero"
    }
  ]
}
{% endschema %}
