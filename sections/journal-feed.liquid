{% assign selected_blog = blogs[section.settings.blog] %}

<section class="section-shell">
  <div class="page-width journal-feed">
    <div class="journal-feed__intro">
      <div>
        {% if section.settings.eyebrow != blank %}
          <div class="eyebrow">{{ section.settings.eyebrow }}</div>
        {% endif %}
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
        {% if section.settings.copy != blank %}
          <div class="section-copy">{{ section.settings.copy }}</div>
        {% endif %}
      </div>

      {% if selected_blog != blank %}
        <a class="button button--secondary" href="{{ selected_blog.url }}">
          {{ section.settings.link_label }}
        </a>
      {% endif %}
    </div>

    <div class="journal-feed__grid journal-feed__grid--{{ section.settings.columns }}">
      {% if selected_blog != blank and selected_blog.articles_count > 0 %}
        {% for article in selected_blog.articles limit: section.settings.posts_to_show %}
          <article class="journal-card">
            <a class="journal-card__link" href="{{ article.url }}">
              <div class="journal-card__media">
                {% if article.image != blank %}
                  {{
                    article.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '360,540,720,960,1200',
                      sizes: '(min-width: 990px) 28vw, 100vw',
                      alt: article.title
                  }}
                {% else %}
                  <img
                    src="{{ 'micnic-photo-lifestyle-hero.png' | asset_url }}"
                    alt="{{ article.title | escape }}"
                    loading="lazy"
                  >
                {% endif %}
              </div>
              <div class="journal-card__content">
                {% if article.tags.size > 0 %}
                  <div class="eyebrow">{{ article.tags.first }}</div>
                {% endif %}
                <h3 class="journal-card__title">{{ article.title }}</h3>
                <p class="journal-card__copy">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
                <span class="journal-card__link-text">{{ section.settings.read_more_label }}</span>
              </div>
            </a>
          </article>
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
          <article class="journal-card" {{ block.shopify_attributes }}>
            <a class="journal-card__link" href="{{ block.settings.link | default: routes.root_url }}">
              <div class="journal-card__media">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '360,540,720,960,1200',
                      sizes: '(min-width: 990px) 28vw, 100vw',
                      alt: block.settings.heading
                  }}
                {% else %}
                  <img
                    src="{{ 'micnic-photo-lifestyle-hero.png' | asset_url }}"
                    alt="{{ block.settings.heading | escape }}"
                    loading="lazy"
                  >
                {% endif %}
              </div>
              <div class="journal-card__content">
                {% if block.settings.kicker != blank %}
                  <div class="eyebrow">{{ block.settings.kicker }}</div>
                {% endif %}
                <h3 class="journal-card__title">{{ block.settings.heading }}</h3>
                <p class="journal-card__copy">{{ block.settings.copy }}</p>
                <span class="journal-card__link-text">{{ section.settings.read_more_label }}</span>
              </div>
            </a>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Journal feed",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "journal"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Training less, living more."
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Copy",
      "default": "<p>Thoughts on balance, movement and modern living.</p>"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "label": "Posts to show",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" }
      ],
      "default": "3"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "View all label",
      "default": "view journal"
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read more label",
      "default": "read more"
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Fallback article",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "Category",
          "default": "mindset"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Training Less, Living More"
        },
        {
          "type": "text",
          "id": "copy",
          "label": "Copy",
          "default": "Thoughts on balance, movement and modern living."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Journal feed",
      "blocks": [
        {
          "type": "article",
          "settings": {
            "kicker": "movement",
            "heading": "Training Less, Living More",
            "copy": "Thoughts on balance, movement and modern living."
          }
        },
        {
          "type": "article",
          "settings": {
            "kicker": "travel",
            "heading": "City To Coast, One Uniform",
            "copy": "A tighter wardrobe for mornings in transit and evenings well dressed."
          }
        },
        {
          "type": "article",
          "settings": {
            "kicker": "style",
            "heading": "The Quiet Power of Better Basics",
            "copy": "Why restraint, fit and fabric outlast fashion noise."
          }
        }
      ]
    }
  ]
}
{% endschema %}
