{% assign desktop_menu_handle = section.settings.menu | default: 'main-menu' %}
{% assign desktop_menu = linklists[desktop_menu_handle] %}
{% assign mobile_menu_handle = section.settings.mobile_menu | default: desktop_menu_handle %}
{% assign mobile_menu = linklists[mobile_menu_handle] %}
{% assign transparent_bg_alpha = section.settings.transparent_background_opacity | times: 0.01 %}
{% assign transparent_background = section.settings.transparent_background | color_modify: 'alpha', transparent_bg_alpha %}
{% assign transparent_mode = section.settings.transparent_mode | default: 'none' %}
{% assign transparent_header = false %}

{% if transparent_mode == 'always' %}
  {% assign transparent_header = true %}
{% elsif transparent_mode == 'home' and request.page_type == 'index' %}
  {% assign transparent_header = true %}
{% endif %}

{% capture site_logo %}
  {% if section.settings.logo_image != blank %}
    <img
      class="site-logo__image"
      src="{{ section.settings.logo_image | image_url: width: 600 }}"
      alt="{{ section.settings.logo_alt | default: shop.name | escape }}"
      loading="eager"
      width="{{ section.settings.logo_image.width }}"
      height="{{ section.settings.logo_image.height }}"
    >
  {% else %}
    <span class="site-logo__text">{{ section.settings.logo_text | default: settings.brand_wordmark | default: shop.name }}</span>
  {% endif %}
{% endcapture %}

<header
  class="site-header{% if section.settings.enable_sticky %} site-header--sticky{% else %} site-header--static{% endif %}{% if transparent_header %} site-header--transparent{% endif %}"
  data-site-header
  data-sticky-enabled="{% if section.settings.enable_sticky %}true{% else %}false{% endif %}"
  data-transparent-enabled="{% if transparent_header %}true{% else %}false{% endif %}"
  style="
    --logo-width-desktop: {{ section.settings.logo_width_desktop }}px;
    --logo-width-mobile: {{ section.settings.logo_width_mobile }}px;
    --header-transparent-text: {{ section.settings.transparent_text_color }};
    --header-transparent-border: {{ section.settings.transparent_border_color }};
    --header-transparent-background: {{ transparent_background }};
  "
>
  <div class="page-width site-header__bar">
    <a class="site-logo" href="{{ routes.root_url }}">{{ site_logo }}</a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {% for link in desktop_menu.links %}
          {% assign link_title_handle = link.title | downcase | strip %}
          {% assign mega_block = blank %}
          {% for block in section.blocks %}
            {% assign block_menu_label = block.settings.menu_item_label | downcase | strip %}
            {% if block.type == 'mega_menu' and block_menu_label == link_title_handle %}
              {% assign mega_block = block %}
              {% break %}
            {% endif %}
          {% endfor %}

          <li class="site-nav__item{% if link.links != blank or mega_block != blank %} site-nav__item--has-panel{% endif %}">
            <a class="site-nav__link" href="{{ link.url }}">
              {{ link.title }}
              {% if link.links != blank or mega_block != blank %}
                {% render 'icon', name: 'chevron' %}
              {% endif %}
            </a>

            {% if link.links != blank or mega_block != blank %}
              <div class="mega-panel" tabindex="-1">
                <div class="mega-panel__grid">
                  <div class="mega-panel__links">
                    <div>
                      <div class="eyebrow">{{ mega_block.settings.eyebrow | default: link.title }}</div>
                      {% if mega_block.settings.heading != blank %}
                        <p class="mega-card__title">{{ mega_block.settings.heading }}</p>
                      {% endif %}
                      {% if mega_block.settings.copy != blank %}
                        <p class="mega-card__caption">{{ mega_block.settings.copy }}</p>
                      {% endif %}
                    </div>

                    <div class="mega-panel__sub-links">
                      {% for child_link in link.links %}
                        <div class="mega-panel__link-group">
                          <a class="mega-panel__link-title" href="{{ child_link.url }}">{{ child_link.title }}</a>
                          {% if child_link.links != blank %}
                            <div class="mega-panel__sub-links">
                              {% for grandchild_link in child_link.links %}
                                <a href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a>
                              {% endfor %}
                            </div>
                          {% endif %}
                        </div>
                      {% else %}
                        <a href="{{ link.url }}">{{ link.title }}</a>
                      {% endfor %}
                    </div>

                    {% if mega_block.settings.highlight_title != blank or mega_block.settings.highlight_copy != blank %}
                      <div class="mega-panel__feature-note">
                        {% if mega_block.settings.highlight_title != blank %}
                          <p class="mega-card__title">{{ mega_block.settings.highlight_title }}</p>
                        {% endif %}
                        {% if mega_block.settings.highlight_copy != blank %}
                          <p class="mega-card__caption">{{ mega_block.settings.highlight_copy }}</p>
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>

                  <div class="mega-panel__cards">
                    {% for index in (1..2) %}
                      {% capture image_key %}card_{{ index }}_image{% endcapture %}
                      {% capture heading_key %}card_{{ index }}_heading{% endcapture %}
                      {% capture caption_key %}card_{{ index }}_caption{% endcapture %}
                      {% capture link_key %}card_{{ index }}_link{% endcapture %}

                      {% assign heading = mega_block.settings[heading_key] %}
                      {% assign caption = mega_block.settings[caption_key] %}
                      {% assign link_url = mega_block.settings[link_key] %}
                      {% assign image = mega_block.settings[image_key] %}
                      {% assign fallback_asset = 'micnic-photo-lifestyle-hero.png' %}
                      {% if index == 2 %}
                        {% assign fallback_asset = 'micnic-photo-bag.png' %}
                      {% endif %}

                      {% if heading != blank or image != blank %}
                        <a class="mega-card__link" href="{{ link_url | default: link.url }}">
                          <article class="mega-card">
                            <div class="mega-card__media">
                              {% if image != blank %}
                                {{
                                  image
                                  | image_url: width: 900
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '240,360,480,720,900',
                                    sizes: '(min-width: 990px) 24vw, 100vw',
                                    alt: heading
                                }}
                              {% else %}
                                <img
                                  src="{{ fallback_asset | asset_url }}"
                                  alt="{{ heading | escape }}"
                                  loading="lazy"
                                >
                              {% endif %}
                            </div>
                            <div class="mega-card__content">
                              <h3 class="mega-card__title">{{ heading }}</h3>
                              {% if caption != blank %}
                                <p class="mega-card__caption">{{ caption }}</p>
                              {% endif %}
                            </div>
                          </article>
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="site-header__actions">
      <button class="icon-button icon-button--menu" type="button" aria-label="Open menu" data-menu-drawer-toggle>
        {% render 'icon', name: 'menu' %}
      </button>
      <a class="icon-button icon-button--desktop" href="{{ routes.search_url }}" aria-label="Search">
        {% render 'icon', name: 'search' %}
      </a>
      {% if shop.customer_accounts_enabled %}
        <a class="icon-button icon-button--desktop" href="{{ routes.account_url }}" aria-label="Account">
          {% render 'icon', name: 'account' %}
        </a>
      {% endif %}
      <a class="icon-button icon-button--cart" href="{{ routes.cart_url }}" aria-label="Cart" data-cart-drawer-toggle>
        {% render 'icon', name: 'bag' %}
        <span class="cart-count-bubble{% if cart.item_count == 0 %} is-hidden{% endif %}" data-cart-count-bubble>
          {{ cart.item_count }}
        </span>
      </a>
    </div>
  </div>

  <div class="header-drawer" aria-hidden="true">
    <div class="header-drawer__panel" role="dialog" aria-modal="true" aria-label="Mobile menu">
      <div class="header-drawer__head">
        <a class="site-logo" href="{{ routes.root_url }}">{{ site_logo }}</a>
        <button class="icon-button" type="button" aria-label="Close menu" data-menu-drawer-close>
          {% render 'icon', name: 'close' %}
        </button>
      </div>

      <nav aria-label="Mobile">
        <ul class="mobile-nav__list">
          {% for link in mobile_menu.links %}
            <li class="mobile-nav__item">
              {% if link.links != blank %}
                <details class="mobile-nav__details">
                  <summary class="mobile-nav__link">
                    <span>{{ link.title }}</span>
                    {% render 'icon', name: 'chevron' %}
                  </summary>
                  <ul class="mobile-nav__sub-list">
                    {% for child_link in link.links %}
                      <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
                    {% endfor %}
                  </ul>
                </details>
              {% else %}
                <a class="mobile-nav__link" href="{{ link.url }}">{{ link.title }}</a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Site header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "micnic"
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo alt text",
      "default": "micnic"
    },
    {
      "type": "range",
      "id": "logo_width_desktop",
      "label": "Logo width desktop",
      "min": 80,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Logo width mobile",
      "min": 60,
      "max": 220,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "select",
      "id": "transparent_mode",
      "label": "Transparent header",
      "options": [
        { "value": "none", "label": "Never" },
        { "value": "home", "label": "Homepage only" },
        { "value": "always", "label": "All pages" }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "transparent_text_color",
      "label": "Transparent header text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "transparent_border_color",
      "label": "Transparent header border color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "transparent_background",
      "label": "Transparent header background color",
      "default": "#e9e4de"
    },
    {
      "type": "range",
      "id": "transparent_background_opacity",
      "label": "Transparent header background opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Desktop menu"
    },
    {
      "type": "link_list",
      "id": "mobile_menu",
      "label": "Mobile menu"
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega menu",
      "settings": [
        {
          "type": "text",
          "id": "menu_item_label",
          "label": "Match menu item label",
          "default": "collections"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "curated edit"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "A sleek, premium lifestyle wardrobe."
        },
        {
          "type": "textarea",
          "id": "copy",
          "label": "Copy",
          "default": "Build the menu around activewear, lifestyle wear, travel, and accessories with strong imagery."
        },
        {
          "type": "text",
          "id": "highlight_title",
          "label": "Highlight title",
          "default": "live timeless"
        },
        {
          "type": "textarea",
          "id": "highlight_copy",
          "label": "Highlight copy",
          "default": "A clean, sleek and sophisticated men's lifestyle proposition with premium fabrication and understated branding."
        },
        {
          "type": "image_picker",
          "id": "card_1_image",
          "label": "Card 1 image"
        },
        {
          "type": "text",
          "id": "card_1_heading",
          "label": "Card 1 heading",
          "default": "lifestyle wear"
        },
        {
          "type": "text",
          "id": "card_1_caption",
          "label": "Card 1 caption",
          "default": "Elevated essentials for city, coast, and downtime."
        },
        {
          "type": "url",
          "id": "card_1_link",
          "label": "Card 1 link"
        },
        {
          "type": "image_picker",
          "id": "card_2_image",
          "label": "Card 2 image"
        },
        {
          "type": "text",
          "id": "card_2_heading",
          "label": "Card 2 heading",
          "default": "travel"
        },
        {
          "type": "text",
          "id": "card_2_caption",
          "label": "Card 2 caption",
          "default": "Performance-minded pieces that pack clean and wear hard."
        },
        {
          "type": "url",
          "id": "card_2_link",
          "label": "Card 2 link"
        }
      ]
    }
  ]
}
{% endschema %}
