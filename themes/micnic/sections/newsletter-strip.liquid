<section class="section-shell">
  <div class="page-width newsletter-strip__grid">
    <div>
      <h2 class="newsletter-strip__title">{{ section.settings.heading }}</h2>
      <p class="footer-copy">{{ section.settings.copy }}</p>
    </div>

    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input
        class="newsletter-form__field"
        type="email"
        name="contact[email]"
        value="{{ form.email }}"
        placeholder="{{ section.settings.placeholder }}"
        autocorrect="off"
        autocapitalize="off"
      >
      <button class="button newsletter-form__button" type="submit">{{ section.settings.button_label }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter strip",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "live timeless"
    },
    {
      "type": "text",
      "id": "copy",
      "label": "Copy",
      "default": "news, launches and inspiration."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "subscribe"
    }
  ]
}
{% endschema %}
